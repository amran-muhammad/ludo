---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ludo Online</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #1a1a2e;
      font-family: 'Segoe UI', system-ui, sans-serif;
      color: #eee;
    }

    .card {
      background: #16213e;
      border: 1px solid #0f3460;
      border-radius: 16px;
      padding: 40px 48px;
      width: 100%;
      max-width: 440px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0,0,0,.4);
    }

    .logo {
      font-size: 3rem;
      margin-bottom: 8px;
    }

    h1 {
      font-size: 2rem;
      font-weight: 700;
      background: linear-gradient(135deg, #e94560, #0f3460);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 6px;
    }

    p.sub {
      color: #888;
      font-size: .9rem;
      margin-bottom: 32px;
    }

    label {
      display: block;
      text-align: left;
      font-size: .85rem;
      color: #aaa;
      margin-bottom: 6px;
    }

    input {
      width: 100%;
      padding: 12px 16px;
      border-radius: 8px;
      border: 1px solid #0f3460;
      background: #0d1b2a;
      color: #eee;
      font-size: 1rem;
      margin-bottom: 20px;
      outline: none;
      transition: border-color .2s;
    }
    input:focus { border-color: #e94560; }

    .btn {
      width: 100%;
      padding: 14px;
      border-radius: 8px;
      border: none;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: opacity .15s;
    }
    .btn:hover { opacity: .88; }
    .btn:disabled { opacity: .4; cursor: not-allowed; }

    .btn-primary {
      background: linear-gradient(135deg, #e94560, #c23152);
      color: #fff;
      margin-bottom: 12px;
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #444;
      font-size: .8rem;
      margin: 8px 0 20px;
    }
    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #333;
    }

    .features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 28px;
    }
    .feat {
      background: #0d1b2a;
      border-radius: 8px;
      padding: 10px 12px;
      font-size: .78rem;
      color: #888;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .feat .icon { font-size: 1.1rem; }

    #status { color: #e94560; font-size: .85rem; margin-top: 8px; min-height: 20px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">🎲</div>
    <h1>Ludo Online</h1>
    <p class="sub">Play with friends or against bots • Share a link to invite</p>

    <label for="name">Your name</label>
    <input id="name" type="text" placeholder="Enter your name…" maxlength="24" />

    <button class="btn btn-primary" id="createBtn">Create New Game</button>

    <div class="divider">or join with a link</div>

    <label for="joinId">Game ID or link</label>
    <input id="joinId" type="text" placeholder="Paste game ID or full link…" />
    <button class="btn" style="background:#0f3460;color:#eee;" id="joinBtn">Join Game</button>

    <p id="status"></p>

    <div class="features">
      <div class="feat"><span class="icon">👥</span> Up to 4 players</div>
      <div class="feat"><span class="icon">🤖</span> Bots fill empty slots</div>
      <div class="feat"><span class="icon">🔗</span> Share link to invite</div>
      <div class="feat"><span class="icon">⚡</span> Real-time multiplayer</div>
    </div>
  </div>

  <script>
    const nameEl = document.getElementById('name');
    const createBtn = document.getElementById('createBtn');
    const joinIdEl = document.getElementById('joinId');
    const joinBtn = document.getElementById('joinBtn');
    const statusEl = document.getElementById('status');

    // Restore saved name
    nameEl.value = localStorage.getItem('ludo_name') || '';

    createBtn.addEventListener('click', async () => {
      const name = nameEl.value.trim();
      if (!name) { statusEl.textContent = 'Please enter your name first.'; return; }
      localStorage.setItem('ludo_name', name);
      createBtn.disabled = true;
      statusEl.textContent = 'Creating game…';
      try {
        const res = await fetch('/api/create', { method: 'POST' });
        const { id } = await res.json();
        window.location.href = `/game/${id}?name=${encodeURIComponent(name)}`;
      } catch {
        statusEl.textContent = 'Failed to create game. Try again.';
        createBtn.disabled = false;
      }
    });

    joinBtn.addEventListener('click', () => {
      const name = nameEl.value.trim();
      if (!name) { statusEl.textContent = 'Please enter your name first.'; return; }
      localStorage.setItem('ludo_name', name);
      let raw = joinIdEl.value.trim();
      // Extract ID from full URL if pasted
      const match = raw.match(/\/game\/([a-z0-9]+)/i);
      const id = match ? match[1] : raw;
      if (!id) { statusEl.textContent = 'Please enter a game ID or link.'; return; }
      window.location.href = `/game/${id}?name=${encodeURIComponent(name)}`;
    });

    nameEl.addEventListener('keydown', e => { if (e.key === 'Enter') createBtn.click(); });
    joinIdEl.addEventListener('keydown', e => { if (e.key === 'Enter') joinBtn.click(); });
  </script>
</body>
</html>
